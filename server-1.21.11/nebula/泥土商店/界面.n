// 界面渲染：$世界.创建界面$ 返回一个界面对象，之后所有操作都针对这个对象，
// 最后把「点击闭包」作为函数值交给 $世界.打开界面$，宿主点击时直接调这个闭包。
// 行数固定 6（54 格）：0 页签 / 4 余额 / 10~33 商品 / 45 49 页签 / 53 关闭。

[函数]画商店 名 页 配置 余额
面:$世界.创建界面 %名% 6 %配置.标题%$
余:%余额%
如果:%余%==
    余:$世界.取物品数 %名% %配置.货币%$
如果尾
$世界.界面物品 %面% 4 %配置.货币% 1 "§e我的余额" "§f%余% 个%配置.货币名%|§8点一下刷新" 是$
$世界.界面物品 %面% 8 minecraft:book 1 "§e商店说明" "§7左键买 1 份，右键买 8 份|§7点商品会弹确认框|§7余额就是背包里的泥土"$
买光:否
卖光:否
如果:%页%==卖
    卖光:是
    $世界.界面物品 %面% 0 minecraft:hopper 1 "§b回收页" "§7把不用的东西换成泥土" 是$
    表:$回收表$
    遍历:i,件=%表%
        $世界.界面物品 %面% %件.槽% %件.物品% %件.数% "§f%件.名称%" "§8%件.说明%|§7回收 §a%件.价% §7%配置.货币名%|§8左键 ×1 · 右键 ×8" 是$
    结束
否则
    买光:是
    $世界.界面物品 %面% 0 minecraft:chest 1 "§a购买页" "§7左键买 1 份，右键买 8 份" 是$
    表:$商品表$
    遍历:i,件=%表%
        $世界.界面物品 %面% %件.槽% %件.物品% %件.数% "§f%件.名称%" "§8%件.说明%|§7售价 §e%件.价% §7%配置.货币名%|§8左键 ×1 · 右键 ×8" 是$
    结束
如果尾
$世界.界面物品 %面% 45 minecraft:chest 1 "§a购买" "§7点这里看商品" %买光%$
$世界.界面物品 %面% 49 minecraft:hopper 1 "§b回收" "§7点这里卖东西" %卖光%$
$世界.界面物品 %面% 53 minecraft:barrier 1 "§c关闭" "§7退出商店"$
点击:[函数]
    点:%参数1%
    槽:%点.槽位%
    如果:%槽%==4
        $画商店 %名% %页% %配置%$
        返回
    如果尾
    如果:%槽%==45
        $世界.音效 %名% %配置.音效点% 0.6 1.4$
        $画商店 %名% 买 %配置%$
        返回
    如果尾
    如果:%槽%==49
        $世界.音效 %名% %配置.音效点% 0.6 1.4$
        $画商店 %名% 卖 %配置%$
        返回
    如果尾
    如果:%槽%==53
        $世界.音效 %名% %配置.音效点% 0.6 0.8$
        $世界.关闭界面 %面%$
        返回
    如果尾
    选:$按槽取 %表% %槽%$
    如果:%选%==
        返回
    如果尾
    量:1
    如果:%点.动作%==右键
        量:8
    如果尾
    选:$JSON键存 %选% 量 %量%$
    $世界.音效 %名% %配置.音效点% 0.6 1.4$
    $画确认 %页% %名% %选% %配置%$
结束
$世界.打开界面 %面% %点击%$

// 确认弹窗：11 确认 / 13 商品 / 15 取消。选中的商品 JSON 由闭包按值捕获，不用再塞界面数据。
[函数]画确认 类 名 选 配置
标:确认购买
如果:%类%==卖
    标:确认回收
如果尾
单:%选.数%
如果:%单%==
    单:1
如果尾
量:%选.量%
如果:%量%==
    量:1
如果尾
合计:[%选.价%*%量%]
面:$世界.创建界面 %名% 3 %标%$
$世界.界面物品 %面% 11 minecraft:lime_stained_glass_pane 1 "§a确认成交" "§7点一下完成交易" 是$
$世界.界面物品 %面% 13 %选.物品% %单% "§f%选.名称%" "§7%选.说明%|§8单价 §e%选.价%§7 %配置.货币名%|§8本次 §e%量%§7 份，合计 §e%合计%§7 %配置.货币名%" 是$
$世界.界面物品 %面% 15 minecraft:red_stained_glass_pane 1 "§c取消" "§7回商店继续逛"$
点击:[函数]
    点:%参数1%
    槽:%点.槽位%
    如果:%槽%==11
        $成交 %类% %名% %选% %配置%$
        返回
    如果尾
    如果:%槽%==15
        $世界.音效 %名% %配置.音效点% 0.6 0.8$
        $画商店 %名% %类% %配置%$
        返回
    如果尾
结束
$世界.打开界面 %面% %点击%$
