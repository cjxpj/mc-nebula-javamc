// 数据层：运行数据统一放插件目录下的 data/，代码目录只留 .n 与说明。
// data/账号.json（按 UUID）、data/会话.json（按玩家名）、data/配置.json、
// data/原状态.json（按 UUID，冻结前的真实模式与坐标，验证成功后删除）。
// 函数帧看不到 [f]初始化 里的变量，配置一律由调用方读好再传进来。

[函数]默认配置
文::{"盐":"","超时":300,"最短":3,"最长":20,"失败上限":5,"成功音":"minecraft:entity.player.levelup","错误音":"minecraft:entity.villager.no","提示音":"minecraft:block.note_block.pling"}
%文%

// 读配置；缺字段补默认值，没有盐就随机生成一个（盐变了旧密码全部失效，别手改）。
[函数]登录配置
文:$读文件 %库目录%/data/配置.json$
如果:$JSON判断 %文%$!=true
    文:$默认配置$
如果尾
如果:%文.超时%==
    文:$JSON键存 %文% 超时 300$
如果尾
如果:%文.最短%==
    文:$JSON键存 %文% 最短 3$
如果尾
如果:%文.最长%==
    文:$JSON键存 %文% 最长 20$
如果尾
如果:%文.失败上限%==
    文:$JSON键存 %文% 失败上限 5$
如果尾
如果:%文.盐%==
    盐:$随机数 100000000 999999999$
    文:$JSON键存字 %文% 盐 %盐%$
    $写文件 %库目录%/data/配置.json %文%$
如果尾
%文%

// 首次加载建好四个文件，坏掉的 JSON 直接重置成空档（配置按默认值重写）。
[函数]检查文件
文:$读文件 %库目录%/data/账号.json$
如果:$JSON判断 %文%$!=true
    $写文件 %库目录%/data/账号.json {}$
如果尾
文:$读文件 %库目录%/data/会话.json$
如果:$JSON判断 %文%$!=true
    $写文件 %库目录%/data/会话.json {}$
如果尾
文:$读文件 %库目录%/data/原状态.json$
如果:$JSON判断 %文%$!=true
    $写文件 %库目录%/data/原状态.json {}$
如果尾
文:$读文件 %库目录%/data/配置.json$
如果:$JSON判断 %文%$!=true
    文:$默认配置$
    $写文件 %库目录%/data/配置.json %文%$
如果尾

// 账号库：{uuid: {名, 密码, 注册, 上次, 次数, 失败}}
[函数]账号库
文:$读文件 %库目录%/data/账号.json$
如果:$JSON判断 %文%$!=true
    文::{}
如果尾
%文%

[函数]账号保存 库
$写文件 %库目录%/data/账号.json %库%$

// 会话：{玩家名: {名, uuid, 态, 输入, 暂, 截止, 模式, 失败, 已提示, 原x/y/z/原维度, 出x/y/z}}
[函数]会话表
文:$读文件 %库目录%/data/会话.json$
如果:$JSON判断 %文%$!=true
    文::{}
如果尾
%文%

[函数]会话取 名
会:$会话表$
条:$JSON键读 %会% %名%$
%条%

[函数]会话存 名 条
会:$会话表$
新:$JSON键存 %会% %名% %条%$
$写文件 %库目录%/data/会话.json %新%$

[函数]会话删 名
会:$会话表$
新:$JSON键删 %会% %名%$
$写文件 %库目录%/data/会话.json %新%$

// 原状态：按 UUID 持久化的「冻结前真实状态」{uuid: {模式, 维度, x, y, z}}。
// 会话会被清理离线会话删掉，玩家存档却会把旁观模式写进磁盘；只靠会话记原状态，
// 未验证就退出再进服时抓到的就是旁观 + 出生点，解冻后又恢复成旁观，永远绕不出来。
// 这张表只在玩家还没被冻结时写一次，验证成功后删除，跨重连 / 重载 / 重启都在。
[函数]原状态表
文:$读文件 %库目录%/data/原状态.json$
如果:$JSON判断 %文%$!=true
    文::{}
如果尾
%文%

[函数]原状态取 uuid
表:$原状态表$
条:$JSON键读 %表% %uuid%$
%条%

[函数]原状态存 uuid 条
表:$原状态表$
新:$JSON键存 %表% %uuid% %条%$
$写文件 %库目录%/data/原状态.json %新%$

[函数]原状态删 uuid
表:$原状态表$
新:$JSON键删 %表% %uuid%$
$写文件 %库目录%/data/原状态.json %新%$

// 重新编译 / 重启后：把「已登录」降级回「登录」，否则关服再进就能跳过密码。
[函数]重置会话
会:$会话表$
键:$JSON全部键 %会%$
遍历:i,名=%键%
    条:$JSON键读 %会% %名%$
    条:$JSON键存 %条% 已提示 0$
    如果:%条.态%==完成
        条:$JSON键存字 %条% 态 登录$
    如果尾
    会:$JSON键存 %会% %名% %条%$
结束
$写文件 %库目录%/data/会话.json %会%$

// 加盐散列：sha256(盐 + uuid + 密码)，账号按 UUID 存，改名也不丢。
[函数]密码散列 盐 键 密码
混:%盐%%键%
混:%混%%密码%
散:$sha256 %混%$
散:$十六进制编码字节 %散%$
%散%

// 建会话：有账号走「登录」，没有走「设置」。
// 原状态表里已有记录 = 上次没验证完就走了，一律复用冻结前的真实模式与坐标，
// 绝不重新抓当前状态（此刻读到的旁观 + 出生点是插件自己造成的，不是玩家原来的）。
// 没有记录且当前就是旁观 / 冒险，也一律按不可信处理，回退生存，避免把冻结态写回存档。
[函数]新建会话 名 uuid 模式 维度 x y z 配置
库:$账号库$
旧态:$原状态取 %uuid%$
如果:%旧态%!=
    模式:%旧态.模式%
    维度:%旧态.维度%
    x:%旧态.x%
    y:%旧态.y%
    z:%旧态.z%
否则
    如果:%模式%==旁观
        模式:生存
    如果尾
    如果:%模式%==冒险
        模式:生存
    如果尾
    如果:%维度%==
        维度:minecraft:overworld
    如果尾
    x:$四舍五入 %x%$
    y:$四舍五入 %y%$
    z:$四舍五入 %z%$
    待::{}
    待:$JSON键存字 %待% 模式 %模式%$
    待:$JSON键存字 %待% 维度 %维度%$
    待:$JSON键存 %待% x %x%$
    待:$JSON键存 %待% y %y%$
    待:$JSON键存 %待% z %z%$
    $原状态存 %uuid% %待%$
如果尾
原x:%x%
原y:%y%
原z:%z%
条::{}
条:$JSON键存字 %条% 名 %名%$
条:$JSON键存字 %条% uuid %uuid%$
如果:$JSON存在 %库% %uuid%$==true
    条:$JSON键存字 %条% 态 登录$
否则
    条:$JSON键存字 %条% 态 设置$
如果尾
条:$JSON键存 %条% 失败 0$
条:$JSON键存 %条% 已提示 0$
条:$JSON键存字 %条% 模式 %模式%$
条:$JSON键存字 %条% 原维度 %维度%$
条:$JSON键存 %条% 原x %原x%$
条:$JSON键存 %条% 原y %原y%$
条:$JSON键存 %条% 原z %原z%$
今:$当前时间戳$
截止:[%今%+%配置.超时%]
条:$JSON键存 %条% 截止 %截止%$
%条%

// 冻结：传送到出生点 + 旁观模式（彻底不能攻击/破坏/放置/用物品，怪物也不索敌）
//       + 失明 + 缓慢 + 隐身 + 无敌（模式切换失败时仍有一层兜底）。
// 出生点存进会话，[事件]每秒 会把跑出去的人拉回来。
// 出生点查不到时绝不传空坐标（会被当成 0 0 0，把玩家塞进方块里），原地冻结即可。
[函数]冻结玩家 名 配置
出:$世界.取复活点坐标$
会:$会话表$
条:$JSON键读 %会% %名%$
如果:%出.x%!=
    条:$JSON键存 %条% 出x %出.x%$
    条:$JSON键存 %条% 出y %出.y%$
    条:$JSON键存 %条% 出z %出.z%$
否则
    条:$JSON键删 %条% 出x$
    条:$JSON键删 %条% 出y$
    条:$JSON键删 %条% 出z$
如果尾
会:$JSON键存 %会% %名% %条%$
$写文件 %库目录%/data/会话.json %会%$
如果:%出.x%!=
    $世界.传送玩家 %名% minecraft:overworld %出.x% %出.y% %出.z%$
如果尾
$世界.设置模式 旁观 %名%$
$世界.设置无敌 %名% 是$
$世界.设置隐身 %名% 是$
$世界.移除效果 %名% minecraft:blindness$
$世界.移除效果 %名% minecraft:slowness$
$世界.移除效果 %名% minecraft:invisibility$
$世界.加效果 %名% minecraft:blindness %配置.超时% 1$
$世界.加效果 %名% minecraft:slowness %配置.超时% 128$
$世界.加效果 %名% minecraft:invisibility %配置.超时% 1$

[函数]归位 名 条
$世界.传送玩家 %名% minecraft:overworld %条.出x% %条.出y% %条.出z%$

// 解冻：清效果 → 恢复冻结前的模式 → 传送回进服位置。
// 旁观 / 冒险都可能是上一局未验证就掉线留下的冻结态，一律回退生存，绝不写回。
[函数]解冻玩家 名 条
$世界.移除效果 %名% minecraft:blindness$
$世界.移除效果 %名% minecraft:slowness$
$世界.移除效果 %名% minecraft:invisibility$
$世界.设置隐身 %名% 否$
$世界.设置无敌 %名% 否$
目:%条.模式%
如果:%目%==
    目:生存
如果尾
如果:%目%==冒险
    目:生存
如果尾
如果:%目%==旁观
    目:生存
如果尾
维:%条.原维度%
如果:%维%==
    维:minecraft:overworld
如果尾
$世界.设置模式 %目% %名%$
$世界.传送玩家 %名% %维% %条.原x% %条.原y% %条.原z%$

// 登录成功后刷新账号记录：上次时间、次数 +1、失败清零。
[函数]记录登录 名 条 账
今:$当前时间$
账:$JSON键存字 %账% 上次 %今%$
登次:1
如果:%账.次数%!=
    登次:[%账.次数%+1]
如果尾
账:$JSON键存 %账% 次数 %登次%$
账:$JSON键存 %账% 失败 0$
库:$账号库$
库:$JSON键存 %库% %条.uuid% %账%$
$账号保存 %库%$

// 两次输入一致：写入账号库，然后走完成验证。
[函数]注册账号 名 条 配置 散
库:$账号库$
今:$当前时间$
新::{}
新:$JSON键存字 %新% 名 %名%$
新:$JSON键存字 %新% 密码 %散%$
新:$JSON键存字 %新% 注册 %今%$
新:$JSON键存字 %新% 上次 %今%$
新:$JSON键存 %新% 次数 1$
新:$JSON键存 %新% 失败 0$
库:$JSON键存 %库% %条.uuid% %新%$
$账号保存 %库%$
$完成验证 %名% %条% %配置%$

// 收尾：会话转「完成」→ 丢掉原状态（下次进服重新抓真实状态）→ 解冻、传回原位、提示。
[函数]完成验证 名 条 配置
条:$JSON键存字 %条% 态 完成$
条:$JSON键删 %条% 输入$
条:$JSON键删 %条% 暂$
$会话存 %名% %条%$
$原状态删 %条.uuid%$
$解冻玩家 %名% %条%$
$世界.音效 %名% %配置.成功音%$
$世界.标题 %名% "§a验证通过" "§f欢迎回来，%名%"$
$世界.提示 %名% "§a验证通过 · 欢迎回来，%名%"$
