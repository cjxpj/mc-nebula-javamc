// 面板层：把「按钮」画在聊天框里。原版 Java 不能下发自定义界面，但聊天文本可以挂点击事件：
// 宿主把 [{文,命令,悬停}] 编成可点击组件，点一下等于以玩家身份执行 /nkey X。
// 键盘只有 0-9 加退格/清空/确认，所以密码是 4-8 位数字。

[函数]发面板 名 条 配置
最新:$会话取 %名%$
如果:%最新%!=
    条:%最新%
如果尾
态:%条.态%
标:§8[§b星云§8] §f设置密码
提:§7点下面的数字输入密码，%配置.最短%-%配置.最长% 位
如果:%态%==确认
    标:§8[§b星云§8] §f再输一次
    提:§7再点一次相同的密码
如果尾
如果:%态%==登录
    标:§8[§b星云§8] §f输入密码
    提:§7点下面的数字输入你的密码
如果尾
$世界.提示 %名% "%标%"$
$世界.提示 %名% "%提%"$
$世界.点击消息 %名% [{"文":"§8[§f1§8] ","命令":"/nkey 1","悬停":"输入 1"},{"文":"§8[§f2§8] ","命令":"/nkey 2","悬停":"输入 2"},{"文":"§8[§f3§8] ","命令":"/nkey 3","悬停":"输入 3"},{"文":"§8[§f4§8] ","命令":"/nkey 4","悬停":"输入 4"},{"文":"§8[§f5§8] ","命令":"/nkey 5","悬停":"输入 5"}]$
$世界.点击消息 %名% [{"文":"§8[§f6§8] ","命令":"/nkey 6","悬停":"输入 6"},{"文":"§8[§f7§8] ","命令":"/nkey 7","悬停":"输入 7"},{"文":"§8[§f8§8] ","命令":"/nkey 8","悬停":"输入 8"},{"文":"§8[§f9§8] ","命令":"/nkey 9","悬停":"输入 9"},{"文":"§8[§f0§8] ","命令":"/nkey 0","悬停":"输入 0"}]$
$世界.点击消息 %名% [{"文":"§c[退格]§r ","命令":"/nkey 退格","悬停":"删掉最后一位"},{"文":"§e[清空]§r ","命令":"/nkey 清空","悬停":"全部清掉"},{"文":"§a[确认]§r","命令":"/nkey 确认","悬停":"提交密码"}]$
条:$JSON键存 %条% 已提示 1$
$会话存 %名% %条%$
$刷新状态 %名% %条% %配置%$

// 状态只刷动作栏（已输入位数 + 剩余秒数一起显示，避免和每秒倒计时互相覆盖），不刷聊天。
[函数]刷新状态 名 条 配置
输:%条.输入%
数:$文本长度 %输%$
掩:$截取 ******** 0 %数%$
今:$当前时间戳$
剩:[%条.截止%-%今%]
如果:%剩%<0
    剩:0
如果尾
剩文:$数字格式化 %剩% 0$
$世界.动作栏 %名% "§7已输入 §f%数% §7位 §8%掩% §7· §f剩 %剩文% §7秒"$

// 输入处理：点聊天按钮实际执行的是 /nkey X，这里把它落成「追加一位 / 退格 / 清空 / 确认」。

[函数]输入数字 名 条 键 配置
位:$文本长度 %键%$
如果:%位%!=1
    返回
如果尾
如果:$匹配整数 %键%$!=true
    $世界.提示 %名% "§c只能点数字按钮输入。"$
    返回
如果尾
输:%条.输入%
长:$文本长度 %输%$
如果:%长%>=%配置.最长%
    $世界.音效 %名% %配置.错误音%$
    $世界.提示 %名% "§c最多 %配置.最长% 位，点「确认」提交。"$
    返回
如果尾
新:%输%%键%
条:$JSON键存字 %条% 输入 %新%$
$会话存 %名% %条%$
$世界.音效 %名% %配置.点击音% 0.6 1.6$
$刷新状态 %名% %条% %配置%$

[函数]退格 名 条 配置
输:%条.输入%
长:$文本长度 %输%$
如果:%长%>0
    新:$截取 %输% 0 [%长%-1]$
    如果:%新%==
        条:$JSON键删 %条% 输入$
    否则
        条:$JSON键存字 %条% 输入 %新%$
    如果尾
    $会话存 %名% %条%$
    $世界.音效 %名% %配置.点击音% 0.5 1.2$
    $刷新状态 %名% %条% %配置%$
如果尾

// 提交：设置（存暂存）→ 确认（比对）→ 登录（查库）。
[函数]提交密码 名 条 配置
输:%条.输入%
长:$文本长度 %输%$
如果:%长%<%配置.最短%
    $世界.音效 %名% %配置.错误音%$
    $世界.提示 %名% "§c太短了：至少 %配置.最短% 位，现在 %长% 位。"$
    $刷新状态 %名% %条% %配置%$
    返回
如果尾
散:$密码散列 %配置.盐% %条.uuid% %输%$
如果:%条.态%==设置
    条:$JSON键存字 %条% 暂 %散%$
    条:$JSON键存字 %条% 态 确认$
    条:$JSON键删 %条% 输入$
    $会话存 %名% %条%$
    $世界.音效 %名% %配置.提示音% 0.8 1.4$
    $世界.提示 %名% "§a第一步完成，请再点一次相同的密码。"$
    $发面板 %名% %条% %配置%$
    返回
如果尾
如果:%条.态%==确认
    如果:%散%==%条.暂%
        $注册账号 %名% %条% %配置% %散%$
        返回
    如果尾
    条:$JSON键存字 %条% 态 设置$
    条:$JSON键删 %条% 暂$
    条:$JSON键删 %条% 输入$
    $会话存 %名% %条%$
    $世界.音效 %名% %配置.错误音%$
    $世界.提示 %名% "§c两次输入不一致，请重新设置密码。"$
    $发面板 %名% %条% %配置%$
    返回
如果尾
如果:%条.态%==登录
    库:$账号库$
    账:$JSON键读 %库% %条.uuid%$
    如果:%账.密码%==%散%
        $记录登录 %名% %条% %账%$
        $完成验证 %名% %条% %配置%$
        返回
    如果尾
    失:[%条.失败%+1]
    条:$JSON键存 %条% 失败 %失%$
    条:$JSON键删 %条% 输入$
    $会话存 %名% %条%$
    余:[%配置.失败上限%-%失%]
    如果:%余%<=0
        $世界.踢出玩家 %名% "§c密码连续错误 %配置.失败上限% 次，请稍后再试"$
        $会话删 %名%$
        返回
    如果尾
    $世界.音效 %名% %配置.错误音%$
    $世界.提示 %名% "§c密码错误，还可以再试 %余% 次。"$
    $刷新状态 %名% %条% %配置%$
    返回
如果尾
